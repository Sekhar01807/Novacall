# Build Outputs & Bundles
dist/
build/
frontend/dist/
frontend/dist-ssr/
frontend/build/

# Test Reports & Playwright Artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright/

# Logs & Runtime Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary / Scratch Files
rewrite.js
backend/resetDb.js
implementation_plan.md
walkthrough.md
task.md
