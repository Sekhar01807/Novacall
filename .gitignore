# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT)
.env
*.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/*.env
backend/.env.*
frontend/.env
